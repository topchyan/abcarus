{
  "name": "abcarus",
  "version": "1.7.0",
  "description": "Desktop application for working with music in ABC notation.",
  "main": "src/main/index.js",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/topchyan/abcarus.git"
  },
  "homepage": "https://github.com/topchyan/abcarus",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "scripts": {
    "start": "electron .",
    "appimage": "bash scripts/build_appimage.sh",
    "pbs:check": "node scripts/check_pbs_lock.mjs",
    "pbs:check-runtime": "node scripts/check_pbs_runtime.mjs",
    "predist:dir": "node scripts/check_pbs_runtime.mjs",
    "predist:win": "node scripts/check_pbs_runtime.mjs",
    "predist:mac": "node scripts/check_pbs_runtime.mjs",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "test:measures": "node devtools/measures_harness/run_tests.js",
    "test:codemirror": "node devtools/codemirror_harness/run_tests.mjs",
    "test:abc-completion": "node devtools/abc_completion_harness/run_tests.mjs",
    "test:editor-commands": "node devtools/editor_commands_harness/run_tests.mjs",
    "test:editor-runtime": "node devtools/editor_runtime_harness/run_tests.mjs",
    "test:transpose": "node devtools/transpose_harness/run_tests.js",
    "test:turkish-notation": "node devtools/turkish_notation_harness/run_tests.mjs",
    "test:note-preview": "node devtools/note_preview_harness/run_tests.mjs",
    "test:midi-input": "node devtools/midi_input_harness/run_tests.mjs",
    "test:microtonal-domain": "node devtools/microtonal_domain_harness/run_tests.mjs",
    "test:settings": "node devtools/settings_harness/run_tests.js",
    "test:font-settings": "node devtools/font_settings_harness/run_tests.mjs",
    "test:global-header-migration": "node devtools/global_header_migration_harness/run_tests.js",
    "test:global-header-packaging": "node scripts/check_global_header_packaging.mjs",
    "test:truth-scale": "node devtools/truth_scale_53_harness/run_tests.js",
    "test:abc2svg-playback": "node devtools/abc2svg_playback_harness/run_tests.js",
    "test:drum-payload": "node devtools/drum_payload_harness/run_tests.mjs",
    "test:charset": "node devtools/charset_harness/run_tests.js",
    "test:focus-playback": "node devtools/focus_playback_harness/run_tests.js",
    "test:payload-mode": "node devtools/payload_mode_harness/run_tests.mjs",
    "test:raw-mode": "node devtools/raw_mode_harness/run_tests.mjs",
    "test:startup": "node devtools/startup_harness/run_tests.mjs",
    "test:library-metadata": "node devtools/library_metadata_harness/run_tests.mjs",
    "test:library-sorting": "node devtools/library_sorting_harness/run_tests.mjs",
    "test:library-catalog-facets": "node devtools/library_catalog_facets_harness/run_tests.mjs",
    "test:library-lifecycle": "node devtools/library_lifecycle_harness/run_tests.mjs",
    "test:library-move": "node devtools/library_move_harness/run_tests.mjs",
    "test:library-append": "node devtools/library_append_harness/run_tests.mjs",
    "test:new-file-action": "node devtools/new_file_action_harness/run_tests.mjs",
    "test:render-domain": "node devtools/render_domain_harness/run_tests.mjs",
    "test:playback-domain": "node devtools/playback_domain_harness/run_tests.mjs",
    "test:runtime-tempo": "node devtools/runtime_tempo_harness/run_tests.mjs",
    "test:soundfont": "node devtools/soundfont_harness/run_tests.mjs",
    "test:app-commands": "node devtools/app_commands_harness/run_tests.mjs",
    "test:document-context": "node devtools/document_context_harness/run_tests.mjs",
    "test:file-runtime": "node devtools/file_runtime_harness/run_tests.mjs",
    "test:single-tune-document": "node devtools/single_tune_document_harness/run_tests.mjs",
    "test:active-tune-context": "node devtools/active_tune_context_harness/run_tests.mjs",
    "test:save-flow": "node devtools/save_flow_harness/run_tests.mjs",
    "test:state-store": "node devtools/state_store_harness/run_tests.js",
    "test:set-list": "node devtools/set_list_harness/run_tests.mjs",
    "test:chordpro": "node devtools/chordpro_harness/run_tests.mjs",
    "test:fileops": "node scripts/check_no_raw_fileops.mjs",
    "test:thirdparty-boundary": "node scripts/check_third_party_boundary.mjs",
    "test:main-cli": "node scripts/check_main_cli_open.mjs",
    "test:file-associations": "node scripts/check_file_associations.mjs",
    "test:repo-privacy": "node scripts/check_repository_privacy.mjs",
    "test:security": "node devtools/security_harness/run_tests.mjs",
    "test:renderer-build": "node scripts/check_renderer_build.mjs && npm run -s test:youtube-metadata",
    "test:youtube-metadata": "node devtools/youtube_metadata_harness/run_tests.mjs",
    "test:musicxml-batch": "node devtools/musicxml_batch_harness/run_tests.cjs",
    "test:renderer-boundaries": "node devtools/renderer_boundaries_harness/run_tests.mjs",
    "test:ui-smoke": "node scripts/ui_smoke.mjs",
    "test:ui-playback-smoke": "node scripts/ui_smoke.mjs --playback",
    "test:ui-payload-smoke": "node scripts/ui_smoke.mjs --payload",
    "test:ui-transform-keys-smoke": "node scripts/ui_smoke.mjs --transform-keys",
    "test:release-preflight": "node scripts/release_preflight.mjs",
    "test:quick": "npm run -s test:repo-privacy && npm run -s test:security && npm run -s test:settings && npm run -s test:font-settings && npm run -s test:global-header-migration && npm run -s test:global-header-packaging && npm run -s test:focus-playback && npm run -s test:abc2svg-playback && npm run -s test:drum-payload && npm run -s test:raw-mode && npm run -s test:startup && npm run -s test:library-metadata && npm run -s test:library-sorting && npm run -s test:library-catalog-facets && npm run -s test:library-lifecycle && npm run -s test:library-move && npm run -s test:library-append && npm run -s test:new-file-action && npm run -s test:render-domain && npm run -s test:playback-domain && npm run -s test:runtime-tempo && npm run -s test:soundfont && npm run -s test:midi-input && npm run -s test:microtonal-domain && npm run -s test:turkish-notation && npm run -s test:app-commands && npm run -s test:abc-completion && npm run -s test:editor-commands && npm run -s test:editor-runtime && npm run -s test:document-context && npm run -s test:active-tune-context && npm run -s test:save-flow && npm run -s test:state-store && npm run -s test:set-list && npm run -s test:chordpro && npm run -s test:musicxml-batch && npm run -s test:fileops && npm run -s test:thirdparty-boundary && npm run -s test:main-cli && npm run -s test:file-associations && npm run -s test:renderer-build && npm run -s test:renderer-boundaries && npm run -s test:codemirror",
    "size:report": "node devtools/size_report.js dist/appimage/AppDir",
    "version:show": "node scripts/show-version.mjs",
    "thirdparty:review": "node scripts/third_party-review.mjs",
    "abc2svg:fetch-tip": "node scripts/fetch_abc2svg_tip_zip.mjs",
    "abc2svg:upgrade": "node scripts/upgrade_abc2svg_from_source_zip.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "publish:patch": "node scripts/publish.mjs patch",
    "publish:minor": "node scripts/publish.mjs minor",
    "publish:major": "node scripts/publish.mjs major"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.27.2",
    "semver": "^7.6.3"
  },
  "dependencies": {
    "tabulator-tables": "^6.3.1"
  },
  "build": {
    "appId": "com.abcarus.ABCarus",
    "productName": "ABCarus",
    "icon": "assets/icons/icon.png",
    "fileAssociations": [
      {
        "ext": "abc",
        "name": "ABC notation",
        "description": "ABC notation score",
        "mimeType": "text/x-abc",
        "role": "Editor"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!kitchen/**",
      "!debug_dumps/**",
      "!docs/qa/**",
      "!docs/roadmaps/**",
      "!devtools/**",
      "!assets/brand/**",
      "!scripts/local/**",
      "!third_party/_upd/**",
      "!third_party/python-embed/.cache/**",
      "!third_party/python-runtime/**",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "third_party/abc2xml/**",
      "third_party/xml2abc/**",
      "third_party/midi2xml/**",
      "third_party/midi2abc/**",
      "third_party/python-embed/**"
    ],
    "directories": {
      "buildResources": "assets/icons",
      "output": "dist/electron-builder"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "minimumSystemVersion": "10.15.0"
    }
  }
}
